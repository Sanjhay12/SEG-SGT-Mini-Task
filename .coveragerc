# Settings for coverage.py. Run the tests with coverage using:
#   coverage run manage.py test
#   coverage report
[run]
source = .
branch = True
omit =
    venv/*
    .venv/*
    */migrations/*
    */tests/*
    manage.py
    config/asgi.py
    config/wsgi.py

[report]
show_missing = True
skip_covered = False

[html]
directory = htmlcov
